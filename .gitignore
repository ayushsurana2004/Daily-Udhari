# ==============================================================================
# Daily Udhari - Master .gitignore
# Covers: Root, Node/React (client/), Spring Boot/Maven (server-java/)
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
client/node_modules/
.pnp/
.pnp.js

# ── Environment Variables & Secrets (CRITICAL: Never commit these) ───────────
.env
.env.*
client/.env
client/.env.*
server-java/.env
server-java/.env.*
*.local

# Optional local Spring config override
server-java/src/main/resources/application-local.properties
server-java/src/main/resources/application-secrets.properties

# ── Build Outputs & Compiled Code ─────────────────────────────────────────────
dist/
client/dist/
build/
client/build/
dist-ssr/
*.tsbuildinfo

# Java / Maven Outputs
target/
**/target/
server-java/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
!server-java/.mvn/wrapper/maven-wrapper.jar

# ── System Files & OS Metadata ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs, Editors & Tooling ───────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Vim / Sublime / Emacs
*.swp
*.swo
*~
*.bak

# ── Testing & Code Quality ────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
.eslintcache

# ── Local Databases & Scratch Files ───────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db3
process.txt
scratch/
